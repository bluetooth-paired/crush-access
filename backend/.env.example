# ============ 模型服务（必填其一） ============
# 方式一：任意 OpenAI 兼容服务（推荐，DeepSeek / Kimi / 自建网关均可）
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 方式二：只填厂商 Key，自动推导 base_url 与默认模型
# DeepSeek: https://api.deepseek.com/v1（默认模型 deepseek-chat）
DEEPSEEK_API_KEY=
# 如需指定具体模型：DEEPSEEK_MODEL=deepseek-reasoner
# Moonshot / Kimi: https://api.moonshot.cn/v1（默认模型 kimi-k3）
MOONSHOT_API_KEY=
# 如需指定具体模型：MOONSHOT_MODEL=kimi-k2.6

# 方式三：平台托管模型网关（部署在本平台时自动可用，无需填写）
# COZE_WORKLOAD_IDENTITY_API_KEY=
# COZE_INTEGRATION_MODEL_BASE_URL=

# 模型调用行为
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=3
# 输出 token 上限；不填则使用配置文件值，并按端点上限自动收敛
# （平台网关 10000 / DeepSeek 8192 / Kimi 8192，避免超过上限直接 400）
# LLM_MAX_COMPLETION_TOKENS=4096
# 结构化输出（JSON 模式）。极少数自建网关不识别 response_format 时可设为 false
LLM_JSON_MODE=true
# 无时区时间戳按此时区解析（默认 +8，微信导出为本地时间）
ASSUME_NAIVE_TZ_OFFSET_HOURS=8
# 服务端默认思考配置（请求 thinking_level=auto 时生效）：enabled / disabled
# 说明：请求级 low/medium/high 仅在端点支持 thinking 参数时生效，详见 docs/api.md B.4
LLM_THINKING=disabled

# ============ 报告与会话有效期 ============
# 分析报告有效期（秒），默认 7 天
ANALYSIS_TTL_SECONDS=604800
# 军师会话有效期（秒），默认 7 天
SESSION_TTL_SECONDS=604800
# 单会话最大轮数
MAX_ADVISOR_TURNS=60

# ============ 存储后端 ============
# memory：进程内存（默认，重启即失效，适合联调）
# postgres：持久化（需提供 DATABASE_URL）
STORE_BACKEND=memory
DATABASE_URL=

# ============ 输入保护 ============
MAX_MESSAGES_PER_REQUEST=3000
MAX_MESSAGE_CHARS=4000
MAX_ADVISOR_MESSAGE_CHARS=2000

# ============ CORS ============
# 逗号分隔的额外允许来源（GitHub Pages 已按正则默认放行）
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOW_ORIGIN_REGEX=https://([a-zA-Z0-9-]+\.)*github\.io
CORS_ALLOW_CREDENTIALS=false

# ============ 服务端口（仅 scripts/run_api.sh 使用） ============
API_PORT=8000

# ============ 证据检索 ============
ADVISOR_EVIDENCE_LIMIT=8
